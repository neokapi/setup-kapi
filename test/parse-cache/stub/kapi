#!/usr/bin/env bash
# A stand-in for the kapi CLI that answers `kapi state path`. With
# KAPI_STUB_STATE_SET=1 it prints KAPI_STUB_STATE_OUTPUT exactly (which may be
# empty or span lines), as a kapi that keeps each checkout's state outside the
# checkout does; otherwise it fails the way a kapi without the command does.
set -euo pipefail
if [ "${1:-}" = "state" ] && [ "${2:-}" = "path" ] && [ "${KAPI_STUB_STATE_SET:-}" = 1 ]; then
  printf '%s' "${KAPI_STUB_STATE_OUTPUT:-}"
  exit 0
fi
echo "Error: unknown command \"${1:-}\" for \"kapi\"" >&2
exit 1
